<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agentos</groupId>
        <artifactId>AgentOS-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>AgentOS-boot</artifactId>
    <description>Spring Boot 启动模块：主类、自动配置、依赖聚合，打包成可执行 JAR</description>

    <dependencies>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-cli</artifactId>
        </dependency>
        <!-- 带入 ToolCallingManager、ToolExecutionExceptionProcessor、spring.ai.tools.* 与 ChatClient.Builder 的自动配置，见技术方案 1.3 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- 只为引入 Reactor（流式调用）；Web 服务器仍是 Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>AgentOS</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.agentos.boot.AgentOSApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
