# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不要提交。
# 本文件只放占位符，可以提交。

# PostgreSQL（需要 pgvector 扩展或建扩展权限）
AGENTOS_DB_URL=jdbc:postgresql://<host>:5432/agentos
AGENTOS_DB_USERNAME=<username>
AGENTOS_DB_PASSWORD=<password>

# 主链路模型 primary（OpenAI 兼容接口，主链路与辅助调用共用），见技术方案 3.5
# base-url 不带 /v1，OpenAI 模块会自己拼接 /v1/chat/completions
AGENTOS_LLM_BASE_URL=https://g7e6ai.com
AGENTOS_LLM_API_KEY=<llm-api-key>
AGENTOS_LLM_MODEL=gpt-5.6-luna

# provider deepseek（DeepSeek 官方接口）。key 留空时该连接不可用，不影响启动
# AGENTOS_DEEPSEEK_MODEL 给 Profile 和冒烟测试用，连接配置本身不带模型
AGENTOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENTOS_DEEPSEEK_API_KEY=
AGENTOS_DEEPSEEK_MODEL=deepseek-flash

# Embedding：阿里云百炼 OpenAI 兼容模式，见技术方案 3.4
# base-url 不带 /v1，OpenAI 模块会自己拼接 /v1/embeddings
AGENTOS_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AGENTOS_EMBEDDING_API_KEY=<dashscope-api-key>
AGENTOS_EMBEDDING_MODEL=text-embedding-v4
AGENTOS_EMBEDDING_DIMENSIONS=1024
