<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agentos</groupId>
        <artifactId>AgentOS-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>AgentOS-tool</artifactId>
    <description>核心能力四：内置 Tool、GovernedToolCallback、ToolRegistry、MCP Client、Sandbox、通知适配器（三合一模块，不要拆）</description>

    <dependencies>
        <dependency>
            <groupId>com.agentos</groupId>
            <artifactId>AgentOS-core</artifactId>
        </dependency>
        <!-- MCP 客户端；自动配置在 application.yaml 里关闭，由 McpClientService 编程式创建 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <!-- 只用 ToolIndex，不用 ToolSearchToolCallingAdvisor，见技术方案 6.9 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tool-search-tool</artifactId>
        </dependency>
    </dependencies>
</project>
