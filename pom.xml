<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.agentos</groupId>
    <artifactId>AgentOS-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AgentOS</name>
    <description>Java 原生、私有部署、可审计的企业级 Agent OS</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <!-- 核心阶段 9 个模块，见技术方案第 10 章 -->
    <modules>
        <module>AgentOS-core</module>
        <module>AgentOS-provider</module>
        <module>AgentOS-memory</module>
        <module>AgentOS-tool</module>
        <module>AgentOS-storage</module>
        <module>AgentOS-web</module>
        <module>AgentOS-channel-cli</module>
        <module>AgentOS-cli</module>
        <module>AgentOS-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- 与上面 parent 的版本保持一致，用于版本信息展示 -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <springdoc.version>3.2.0</springdoc.version>
        <picocli.version>4.7.7</picocli.version>
        <shedlock.version>7.10.1</shedlock.version>
        <!-- 工程基线：质量门插件（版本 2026-11 从 Maven Central 核实） -->
        <spotless.version>3.11.0</spotless.version>
        <google-java-format.version>2.0.0</google-java-format.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.4.0</checkstyle.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <spotbugs.version>4.10.5</spotbugs.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 官方 BOM，不引入任何 com.alibaba.cloud.ai 依赖 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 项目内模块 -->
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-channel-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>llm</id>
            <properties>
                <skip.llm.tests>false</skip.llm.tests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>llm</groups>
                            <excludedGroups></excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- 所有模块都能写测试：JUnit 6、AssertJ、Mockito、spring-test -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 工程基线：所有检查都绑定在 verify 阶段，`mvn verify` 失败 = 违反规范。子模块自动继承 -->
    <build>
        <plugins>
            <!-- 默认跳过真实模型冒烟；-Pllm 显式启用 llm 标签。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>llm</excludedGroups>
                </configuration>
            </plugin>
            <!-- 依赖与环境禁令：版本由 spring-boot-starter-parent 管理 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- 技术栈约束：不用 Spring AI Alibaba，不用厂商 SDK -->
                                        <exclude>com.alibaba.cloud.ai</exclude>
                                        <exclude>com.alibaba:dashscope-sdk-java</exclude>
                                        <!-- 只用 PostgreSQL，不用 SQLite/H2 -->
                                        <exclude>com.h2database</exclude>
                                        <exclude>org.xerial:sqlite-jdbc</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 格式化：Google Java Style，AOSP 变体（4 空格缩进）。本地先跑 mvn spotless:apply -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <!-- 要纯 Google 风格（2 空格）就改成 GOOGLE -->
                            <style>AOSP</style>
                            <reflowLongStrings>false</reflowLongStrings>
                            <!-- 不重排 Javadoc：中文注释按半角宽度折行会被打乱 -->
                            <formatJavadoc>false</formatJavadoc>
                        </googleJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- 风格：只查格式化器管不到的命名、导入、编码习惯 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- 缺陷 + 安全：SpotBugs 加 FindSecBugs（注入、弱加密、路径穿越、不安全反序列化等） -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
