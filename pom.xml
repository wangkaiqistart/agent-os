<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.agentos</groupId>
    <artifactId>AgentOS-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AgentOS</name>
    <description>Java 原生、私有部署、可审计的企业级 Agent OS</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <!-- 核心阶段 9 个模块，见技术方案第 10 章 -->
    <modules>
        <module>AgentOS-core</module>
        <module>AgentOS-provider</module>
        <module>AgentOS-memory</module>
        <module>AgentOS-tool</module>
        <module>AgentOS-storage</module>
        <module>AgentOS-web</module>
        <module>AgentOS-channel-cli</module>
        <module>AgentOS-cli</module>
        <module>AgentOS-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- 与上面 parent 的版本保持一致，用于版本信息展示 -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <springdoc.version>3.2.0</springdoc.version>
        <picocli.version>4.7.7</picocli.version>
        <shedlock.version>7.10.1</shedlock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 官方 BOM，不引入任何 com.alibaba.cloud.ai 依赖 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 项目内模块 -->
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-channel-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentos</groupId>
                <artifactId>AgentOS-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
